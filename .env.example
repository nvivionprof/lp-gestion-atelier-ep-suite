# LP Gestion Atelier EP Suite — V0.0.1
# Mode par défaut : test local WSL/PC via un seul port HTTP.

LP_DEPLOY_MODE=local
SERVER_IP=localhost
PUBLIC_DOMAIN=localhost:9000
PUBLIC_SCHEME=http
EXPOSURE_MODE=local
LOCAL_PUBLIC_HOST=localhost:9000
NETWORK_PUBLIC_HOST=192.168.101.19:9000
EXTERNAL_PUBLIC_DOMAIN=stjoseph-lpsuite.duckdns.org
ENABLE_HTTPS=0

# Passerelle unique Nginx. En local : http://localhost:9000
# En production DuckDNS : mettre GATEWAY_HTTP_PORT=80 et GATEWAY_HTTPS_PORT=443.
GATEWAY_HTTP_PORT=9000
GATEWAY_HTTPS_PORT=9443
LP_CORE_PORT=9000
TOOLMAG_PORT=9001
SAFETY_PORT=9002
PEDASHOP_PORT=9003
CONSUMABLES_PORT=9003
INVENTORY_PORT=9004
SYSTEM_MANAGER_PORT=9004
TPMANAGER_PORT=9005
PFMP_PORT=9006

LP_CORE_PUBLIC_URL=http://localhost:9000
TOOLMAG_PUBLIC_BASE_URL=http://localhost:9000/toolmag/
SAFETY_PUBLIC_URL=http://localhost:9000/safety/
PEDASHOP_PUBLIC_URL=http://localhost:9000/pedashop/
CONSUMABLES_PUBLIC_URL=http://localhost:9000/pedashop/
INVENTORY_PUBLIC_URL=http://localhost:9000/system/
SYSTEM_MANAGER_PUBLIC_URL=http://localhost:9000/system/
TPMANAGER_PUBLIC_URL=http://localhost:9000/tpmanager/
PFMP_PUBLIC_URL=http://localhost:9000/pfmp/

TOOLMAG_INTERNAL_SYNC_URL=http://toolmag-app:8000/api/internal/sync-lp-core/
PEDASHOP_INTERNAL_SYNC_URL=http://pedashop-app:8000/api/internal/sync-lp-core/
SAFETY_INTERNAL_SYNC_URL=http://safety-app:8000/sync-lp-core/
SYSTEM_MANAGER_INTERNAL_SYNC_URL=http://system-manager-app:8000/sync-lp-core/
TPMANAGER_INTERNAL_SYNC_URL=http://tpmanager-app:8000/sync-lp-core/
PFMP_INTERNAL_SYNC_URL=http://pfmp-app:8000/sync-lp-core/

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
CSRF_TRUSTED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Isolation des cookies par application : évite les collisions de sessions derrière le portail unique.
LP_CORE_SESSION_COOKIE_NAME=lp_core_sessionid
LP_CORE_CSRF_COOKIE_NAME=lp_core_csrftoken
SAFETY_SESSION_COOKIE_NAME=safety_sessionid
SAFETY_CSRF_COOKIE_NAME=safety_csrftoken
PEDASHOP_SESSION_COOKIE_NAME=pedashop_sessionid
PEDASHOP_CSRF_COOKIE_NAME=pedashop_csrftoken
SYSTEM_MANAGER_SESSION_COOKIE_NAME=system_manager_sessionid
SYSTEM_MANAGER_CSRF_COOKIE_NAME=system_manager_csrftoken
TPMANAGER_SESSION_COOKIE_NAME=tpmanager_sessionid
TPMANAGER_CSRF_COOKIE_NAME=tpmanager_csrftoken
PFMP_SESSION_COOKIE_NAME=pfmp_sessionid
PFMP_CSRF_COOKIE_NAME=pfmp_csrftoken
PFMP_SSO_TOKEN_MAX_AGE=600
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# À changer en production
MODULE_SYNC_TIMEOUT_SECONDS=90
LP_CORE_EXPOSE_INITIAL_PASSWORD_FOR_SYNC=1
LP_CORE_API_TOKEN=change_me_internal_core_token
DJANGO_SECRET_KEY=change_me_global_secret_key

# Admin initial LP Core et Django /admin/ : admin/admin, changement obligatoire côté LP Core.
LP_CORE_ADMIN_PASSWORD=CHANGE_ME_INSTALLER_WILL_SET

# Import automatique au premier install : vide par défaut pour garder la base démo.
LP_CORE_IMPORT_XLSX=

# Mode démo ToolMag : 1 = charge la base demo si aucune base ToolMag n'existe ; 0 = base neuve + migrations
TOOLMAG_USE_DEMO_DB=1

TZ=Europe/Paris
BACKUP_RETENTION_DAYS=7
BACKUP_DAILY_HOUR=02
BACKUP_DAILY_MINUTE=00
BACKUP_ENABLED=1
BACKUP_MANUAL_KEEP_FOREVER=1
BACKUP_PRE_UPGRADE_REQUIRED=1
BACKUP_BLOCK_UPDATE_IF_BACKUP_FAILED=1
BACKUP_WEB_RESTORE_ENABLED=1

# Versions affichées
LP_CORE_VERSION="LP Core — RC V0.0.1"
APP_VERSION="ToolMag — RC V0.0.1"
SAFETY_VERSION="Safety Manager — RC V0.0.1"
PEDASHOP_VERSION="PedaShop — RC V0.0.1"
SYSTEM_MANAGER_VERSION="System Manager — RC V0.0.1"
TPMANAGER_VERSION="TP Manager — RC V0.0.1"
PFMP_VERSION="PFMP Manager — RC V0.0.1"

# Synchronisation : 0 = ne réinitialise pas les mots de passe lors des synchronisations suivantes
SAFETY_RESET_PASSWORDS_ON_SYNC=0
PEDASHOP_RESET_PASSWORDS_ON_SYNC=0
SYSTEM_MANAGER_RESET_PASSWORDS_ON_SYNC=0
TPMANAGER_RESET_PASSWORDS_ON_SYNC=0
PFMP_RESET_PASSWORDS_ON_SYNC=0

# HTTPS / certificats centralisés dans lp-gateway
SSL_DIR=./ssl
SSL_CERT_FILE=/ssl/fullchain.pem
SSL_KEY_FILE=/ssl/privkey.pem
CERT_CHALLENGE_METHOD=dns_duckdns
LETSENCRYPT_EMAIL=
DUCKDNS_TOKEN=

# Maintenance web / mises à jour par navigateur
SUITE_ALLOW_WEB_MAINTENANCE=0
SUITE_ADMIN_AGENT_URL=http://suite-admin-agent:8079
MAX_UPDATE_ZIP_SIZE_MB=2048
SUITE_HOST_ROOT=
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=lp_core
POSTGRES_USER=lp_suite_user
POSTGRES_PASSWORD=CHANGE_ME_INSTALLER_WILL_SET
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=lp_core,toolmag,safety,pedashop,system_manager,tpmanager,pfmp
LP_CORE_DB_NAME=lp_core
TOOLMAG_DB_NAME=toolmag
SAFETY_DB_NAME=safety
PEDASHOP_DB_NAME=pedashop
SYSTEM_MANAGER_DB_NAME=system_manager
TPMANAGER_DB_NAME=tpmanager
PFMP_DB_NAME=pfmp
LP_CORE_ADMIN_USERNAME=admin
RUN_MIGRATIONS=1

# Démonstration / vérification archive
# Chargement des données de démonstration.
# Utilisé automatiquement uniquement en mode install. Ignoré/forcé à 0 en update/upgrade.
LOAD_DEMO_DATA=0
LP_CORE_DEMO_XLSX=/imports/base_demo_lp_core.xlsx
ENABLE_DB_SUPERVISION=1
CHECKSUM_VERIFY_ON_INSTALL=1

# Sécurité exploitation
WEB_APP_UPDATE_ALLOWED=0
WEB_DB_BACKUP_RESTORE_ALLOWED=1
