# LP Gestion Atelier EP Suite — exemple de configuration
# Copier ce fichier vers .env et adapter les valeurs.

COMPOSE_PROJECT_NAME=lp_gestion_atelier_ep_suite

# Domaine / URL publique
# Un seul port public : 9000
PUBLIC_BASE_URL=http://localhost:9000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:9000

# Mode Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=CHANGE_ME_DEV_ONLY
DJANGO_TIME_ZONE=Europe/Paris
DJANGO_LANGUAGE_CODE=fr-fr

# Base de données
POSTGRES_DB=lp_suite
POSTGRES_USER=lp_suite_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Port public frontal unique
PUBLIC_HTTP_PORT=9000

# Chemins publics des modules
LP_CORE_BASE_PATH=/
TOOLMAG_BASE_PATH=/toolmag/
SAFETY_MANAGER_BASE_PATH=/safety/
SYSTEM_MANAGER_BASE_PATH=/systemes/
TP_MANAGER_BASE_PATH=/tp/
PEDASHOP_BASE_PATH=/pedashop/
PFMP_MANAGER_BASE_PATH=/pfmp/

# URLs internes Docker
# Ces URLs restent internes au réseau Docker et ne doivent pas être exposées publiquement.
LP_CORE_INTERNAL_URL=http://lp-core:8000
TOOLMAG_INTERNAL_URL=http://toolmag:8000
SAFETY_MANAGER_INTERNAL_URL=http://safety-manager:8000
SYSTEM_MANAGER_INTERNAL_URL=http://system-manager:8000
TP_MANAGER_INTERNAL_URL=http://tp-manager:8000
PEDASHOP_INTERNAL_URL=http://pedashop:8000
PFMP_MANAGER_INTERNAL_URL=http://pfmp-manager:8000

# Sauvegardes
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/app/backups

# Compte initial LP Core
LP_CORE_INITIAL_ADMIN_USERNAME=admin
LP_CORE_INITIAL_ADMIN_PASSWORD=admin
LP_CORE_FORCE_PASSWORD_CHANGE=1
