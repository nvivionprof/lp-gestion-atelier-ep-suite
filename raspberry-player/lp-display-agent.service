[Unit]
Description=LP Display Manager Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/lp-display-player.env
ExecStart=/usr/bin/python3 /opt/lp-display-player/lp-display-agent.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
