[Unit]
Description=LP Display Manager Chromium Kiosk
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
EnvironmentFile=/etc/lp-display-player.env
ExecStart=/opt/lp-display-player/kiosk-start.sh
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
